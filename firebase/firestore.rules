rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'owner'
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isActive == true;
    }

    function hasOnlyKeys(data, keys) {
      return data.keys().hasOnly(keys);
    }

    match /userProfiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      // Owner accounts are provisioned by a trusted administrator, never by a browser client.
      allow create, update, delete: if false;
    }

    match /publicProducts/{productId} {
      allow get, list: if isOwner() || resource.data.isPublished == true;
      allow create, update: if isOwner()
        && hasOnlyKeys(request.resource.data, [
          'name', 'slug', 'shortDescription', 'categoryId', 'categoryName',
          'price', 'imagePath', 'availability', 'isPublished', 'sortOrder', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.slug is string
        && request.resource.data.slug.size() >= 1
        && request.resource.data.slug.size() <= 140
        && request.resource.data.shortDescription is string
        && request.resource.data.categoryId is string
        && request.resource.data.categoryName is string
        && (request.resource.data.price == null
          || (request.resource.data.price is int && request.resource.data.price >= 0))
        && request.resource.data.imagePath is string
        && request.resource.data.availability in ['AVAILABLE', 'SOLD_OUT', 'PRE_ORDER']
        && request.resource.data.isPublished is bool
        && request.resource.data.sortOrder is int
        && request.resource.data.sortOrder >= 0;
      allow delete: if false;
    }

    match /publicCategories/{categoryId} {
      allow get, list: if isOwner() || resource.data.isActive == true;
      allow create, update: if isOwner()
        && hasOnlyKeys(request.resource.data, ['name', 'sortOrder', 'isActive', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.sortOrder is int
        && request.resource.data.sortOrder >= 0
        && request.resource.data.isActive is bool;
      allow delete: if false;
    }

    match /publicSettings/{documentId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isOwner()
        && documentId == 'storefront'
        && hasOnlyKeys(request.resource.data, [
          'displayName', 'tagline', 'whatsappNumber', 'instagramHandle', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.tagline is string
        && request.resource.data.whatsappNumber is string
        && request.resource.data.instagramHandle is string;
      allow delete: if false;
    }

    match /products/{productId} {
      allow read, create, update: if isOwner();
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read, create, update: if isOwner();
      allow delete: if false;
    }

    // Orders, payments, inventory, and sale mutations are trusted-backend-only.
    match /orders/{orderId} {
      allow get: if isOwner() || (signedIn() && resource.data.createdByUid == request.auth.uid);
      allow list: if isOwner();
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    match /inventory/{productId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    match /stockMovements/{movementId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    match /productionRuns/{runId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    match /directSales/{saleId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    match /privateSettings/{documentId} {
      allow read, create, update: if isOwner();
      allow delete: if false;
    }

    match /orderPrivate/{orderId} {
      allow read, create, update: if isOwner();
      allow delete: if false;
    }

    match /activityLogs/{logId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    // Deny-by-default for every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
