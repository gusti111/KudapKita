# Firebase Web App configuration (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public WhatsApp Business number, international format without + or spaces.
# Example format only; replace with the real KudapKita number.
VITE_PUBLIC_WHATSAPP_NUMBER=

# Optional: show a small demo-mode notice when Firebase is not configured.
VITE_ENABLE_DEMO_CATALOG=true
